<?xml version="1.0" encoding="utf-8"?>
<!--
  Crescent moon with a few stars. Drawn as a vector so the repository stays
  source-only - there are no opaque binary assets anywhere in this project.
  The 108dp canvas with content inside the middle 72dp is the adaptive-icon
  safe zone (roughly x,y in 18..90).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      Crescent = outer disc minus an overlapping inner disc, using evenOdd so the
      intersection is knocked out. Outer: centre (62,54) r=23. Inner: centre
      (51,45) r=20, offset up and left, which opens the crescent toward the
      top-left where the stars sit.
    -->
    <path
        android:fillType="evenOdd"
        android:fillColor="#E8ECFF"
        android:pathData="M39,54 a23,23 0 1,0 46,0 a23,23 0 1,0 -46,0 Z
                          M31,45 a20,20 0 1,0 40,0 a20,20 0 1,0 -40,0 Z" />

    <!-- Stars, placed in the open side of the crescent. -->
    <path
        android:fillColor="#9BB0FF"
        android:pathData="M40,30 l1.7,4.4 4.4,1.7 -4.4,1.7 -1.7,4.4 -1.7,-4.4 -4.4,-1.7 4.4,-1.7 Z" />
    <path
        android:fillColor="#7C90E0"
        android:pathData="M27,62 l1.2,3.1 3.1,1.2 -3.1,1.2 -1.2,3.1 -1.2,-3.1 -3.1,-1.2 3.1,-1.2 Z" />
    <path
        android:fillColor="#6B7FD0"
        android:pathData="M55,24 l0.9,2.3 2.3,0.9 -2.3,0.9 -0.9,2.3 -0.9,-2.3 -2.3,-0.9 2.3,-0.9 Z" />
</vector>
