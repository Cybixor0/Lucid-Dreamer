<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose supplies the real theming (see ui/theme/Theme.kt). This XML theme
      exists only so the window has sensible colours before Compose draws its
      first frame, which avoids a white flash when opening the app at night.
    -->
    <style name="Theme.LucidDreamer" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
