<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup and device-transfer are disabled by default. A dream journal is deeply
  personal and must not be swept into a cloud backup without an explicit choice.
  Use Settings -> Privacy -> Export data for a manual, local, file-based backup
  you control. See PRIVACY.md.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
