<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      ============================================================================
      PERMISSIONS
      ============================================================================
      Note what is ABSENT: android.permission.INTERNET is never declared. The app
      is structurally incapable of sending anything off the device, and anyone can
      verify that by reading this file. See PRIVACY.md.

      Every permission below is explained in PERMISSIONS.md and on the in-app
      Privacy screen, including what breaks if you refuse it.
    -->

    <!--
      Exact alarms. USE_EXACT_ALARM is a normal permission (auto-granted, not
      user-revocable) intended for alarm-clock apps, which this genuinely is: it
      wakes you for WBTB. It also exempts the app from the RESTRICTED App Standby
      bucket's one-alarm-per-day cap, which would otherwise be fatal overnight.
      The Google Play policy restricting it does not apply here - this app is not
      distributed through Play. SCHEDULE_EXACT_ALARM covers API 31/32, where
      USE_EXACT_ALARM does not yet exist.
    -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <!-- Re-arm the night's alarms after a reboot; alarms do not survive shutdown. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Brief wake lock bridging alarm delivery to cue playback. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Foreground services: the session notification, and cue playback. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!--
      Only claimed at runtime when you have switched on microphone sleep
      sensing AND the session was started from the open app. Android refuses
      microphone access to a service started from the background, so an
      automatic overnight start silently falls back to movement-only sensing.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Android 13+: the ongoing session notification and reality-check reminders. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Optional cue style, and a gentler alternative to audio. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Requested only if you choose to record your own voice cue, or dictate a
      dream. Never used for background listening in this build; microphone-based
      sleep estimation is a later, separately opt-in phase.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      Overnight work is unreliable under Doze without this. Requested explicitly,
      with an explanation, and the app degrades gracefully if refused.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      Optional. Lets the app tell you *before* you sleep that Do Not Disturb is
      configured to silence alarms, which would otherwise make cues fail silently.
    -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <application
        android:name=".LucidDreamerApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LucidDreamer">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.LucidDreamer"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Runs for the duration of a night: the ongoing notification, its
          controls, and the proof-of-life heartbeat. It is NOT the timing
          mechanism - see AlarmScheduler.

          specialUse, not dataSync: dataSync is capped at six hours per day,
          which would kill an eight-hour night outright. The subtype property
          below is mandatory for specialUse; the service will not start without it.
        -->
        <service
            android:name=".service.SleepSessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Overnight sleep session: keeps the user's scheduled audio cue
                    timeline active while they sleep, shows session state and controls, and
                    records proof-of-life so missed cues can be diagnosed in the morning." />
        </service>

        <!--
          Plays one cue, then stops. mediaPlayback is required because recent
          Android silently blocks background audio unless a foreground service
          is running; it also has no time limit and, not being a while-in-use
          type, can legitimately be started from the background by an exact alarm.
        -->
        <service
            android:name=".service.CuePlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Cue delivery. Takes a wake lock, hands off to the playback service. -->
        <receiver
            android:name=".service.CueAlarmReceiver"
            android:exported="false" />

        <!-- Ten-minute repair loop: re-arms anything that was dropped. -->
        <receiver
            android:name=".service.WatchdogReceiver"
            android:exported="false" />

        <!-- Wake Back To Bed. -->
        <receiver
            android:name=".service.WbtbReceiver"
            android:exported="false" />

        <!-- Notification and lock-screen session controls. -->
        <receiver
            android:name=".service.SessionControlReceiver"
            android:exported="false" />

        <!-- Automatic session start at bedtime. -->
        <receiver
            android:name=".service.SessionAutoStartReceiver"
            android:exported="false" />

        <!-- Daytime reality-check reminders. -->
        <receiver
            android:name=".service.ReminderReceiver"
            android:exported="false" />

        <!-- The "test a cue with the screen off" check on the Reliability screen. -->
        <receiver
            android:name=".service.TestCueReceiver"
            android:exported="false" />

        <!--
          All four of these events cancel or invalidate pending alarms, so the
          app has to put itself back together. This is exactly why cue rules are
          stored as wall-clock rules rather than resolved timestamps: after a
          clock, timezone or daylight-saving change the rules still mean what
          the user intended and the instants can simply be recomputed.
        -->
        <receiver
            android:name=".service.BootAndTimeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
